{
  "productName": "ShoreShot",
  "version": "../../package.json",
  "identifier": "biz.ontheshore.shoreshot",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "windows": ["overlay", "settings"],
          "permissions": ["core:default"]
        }
      ]
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
