{
  "productName": "ShoreShot Spike",
  "version": "0.0.0",
  "identifier": "biz.ontheshore.shoreshot.spike",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "windows": [
            "overlay"
          ],
          "permissions": [
            "core:default"
          ]
        }
      ]
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}